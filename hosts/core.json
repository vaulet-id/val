{
  "_comment": "What this host provides to a Micro App: one registry, one version. `draws` says a capability is written in a screen's tree; without it, it is called in `execute`. `consent` says it appears on the sheet the person approves — a policy attribute, not a category.",
  "host": "org.val.core",
  "version": 1,
  "screen": {
    "props": {
      "start": "bool?",
      "present": "Present?",
      "address": "Address?"
    }
  },
  "capabilities": {
    "column": {
      "draws": true,
      "props": {
        "gap": "Gap?",
        "align": "Align?"
      },
      "children": true
    },
    "row": {
      "draws": true,
      "props": {
        "gap": "Gap?",
        "align": "Align?"
      },
      "children": true
    },
    "divider": {
      "draws": true,
      "props": {
        "style": "DividerStyle?"
      }
    },
    "section": {
      "draws": true,
      "props": {
        "text": "Text",
        "style": "SectionStyle?"
      },
      "primary": "text"
    },
    "card": {
      "draws": true,
      "props": {
        "text": "Text",
        "onTap": "Action?"
      },
      "children": true,
      "primary": "text"
    },
    "tile": {
      "draws": true,
      "props": {
        "text": "Text",
        "detail": "Text?",
        "icon": "Icon?",
        "trailing": "Trailing?",
        "onTap": "Action?"
      },
      "primary": "text"
    },
    "list": {
      "draws": true,
      "props": {
        "of": "List<T>",
        "onRemove": "Action?"
      },
      "children": true,
      "primary": "of"
    },
    "image": {
      "draws": true,
      "props": {
        "asset": "Asset"
      },
      "primary": "asset"
    },
    "button": {
      "draws": true,
      "props": {
        "text": "Text",
        "emphasis": "Emphasis?",
        "icon": "Icon?",
        "state": "State?",
        "onTap": "Action"
      },
      "primary": "text"
    },
    "field": {
      "draws": true,
      "props": {
        "text": "Text",
        "kind": "FieldKind?",
        "icon": "Icon?",
        "into": "Name"
      },
      "primary": "text"
    },
    "pick": {
      "draws": true,
      "props": {
        "text": "Text",
        "of": "List<T>?",
        "kind": "PickKind?",
        "into": "Name"
      },
      "primary": "text"
    },
    "toggle": {
      "draws": true,
      "props": {
        "text": "Text",
        "into": "Name"
      },
      "primary": "text"
    },
    "progress": {
      "draws": true,
      "props": {
        "text": "Text?",
        "value": "int",
        "of": "int"
      },
      "primary": "text"
    },
    "credentialCard": {
      "draws": true,
      "props": {
        "of": "Verified"
      },
      "primary": "of"
    },
    "claim": {
      "draws": true,
      "props": {
        "text": "Text",
        "of": "Claim"
      },
      "primary": "text"
    },
    "qr": {
      "draws": true,
      "props": {
        "of": "Presentation"
      },
      "primary": "of"
    },
    "notice": {
      "draws": true,
      "props": {
        "text": "Text",
        "tone": "Tone?"
      },
      "primary": "text"
    },
    "banner": {
      "draws": true,
      "props": {
        "text": "Text",
        "detail": "Text?",
        "image": "Asset?",
        "icon": "Icon?",
        "onTap": "Action?"
      },
      "primary": "text"
    },
    "carousel": {
      "draws": true,
      "props": {
        "of": "List<T>?"
      },
      "children": true
    },
    "grid": {
      "draws": true,
      "props": {
        "of": "List<T>?",
        "columns": "int?"
      },
      "children": true,
      "primary": "of"
    },
    "credential.read": {
      "consent": true,
      "props": {
        "of": "Type"
      }
    },
    "credential.issue": {
      "consent": true,
      "props": {
        "of": "Credential"
      }
    },
    "payment.request": {
      "consent": true,
      "props": {
        "to": "string",
        "amount": "int"
      },
      "reversible": false
    },
    "storage.write": {
      "consent": true,
      "props": {
        "scope": "string",
        "id": "string",
        "value": "any"
      }
    },
    "message.send": {
      "consent": true,
      "props": {
        "to": "string"
      },
      "reversible": false
    },
    "network.request": {
      "consent": true,
      "props": {
        "audience": "string"
      }
    },
    "disclosure.present": {
      "consent": true,
      "props": {},
      "reversible": false
    },
    "navigation.navigate": {
      "props": {
        "to": "Screen",
        "as": "Transition?",
        "present": "Present?"
      }
    },
    "navigation.back": {
      "props": {
        "with": "Record?"
      }
    }
  },
