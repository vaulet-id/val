// Scan a purchase receipt, earn points, reissue the membership credential.
//
// The canonical example: every phase, both verifiability types, and the thing
// that makes VAL different from a scripting language — the compiler knowing,
// before it runs, that this app can issue exactly one credential type and read
// exactly one other.

app "th.co.codefin.loyalty"
version 1

capabilities {
  // Type references, not strings. The types are declared below; a string here
  // would be an unchecked second copy of a name.
  credential.read(PurchaseReceipt)
  credential.issue(LoyaltyMember)
}

enum Tier { bronze, silver, gold }

credential PurchaseReceipt {
  merchant:     string
  amount:       int        // satang. There is no float in the language, and
  purchased_at: datetime   // money did not want one.
}

credential LoyaltyMember {
  member_id: string
  tier:      Tier
  points:    int
}

state {
  member:         LoyaltyMember?
  lifetimePoints: int default 0
}

// The subject is bound by name. `receipt.signature.valid`, never a bare
// `signature.valid` — an implicit receiver is unambiguous exactly until a
// second credential is in scope.
trust ReceiptFromMerchant(receipt: PurchaseReceipt) {
  // An anchor, not a pinned issuer: the chain answers who is under it. Pinning
  // would put this app's private allowlist somewhere the person cannot see.
  anchor: "th.co.codefin.merchants"

  require {
    receipt.signature.valid
    receipt.status.active
    receipt.holder.bound
    receipt.claims.amount > 0
  }
}

// A switch arm may be a comparison, so this reads as a table. A chain of `?:`
// would say the same thing to a programmer and nothing at all to the partner
// deciding whether to publish the app.
function tierFor(points: int): Tier {
  return switch (points) {
    >= 10000 => Tier.gold,
    >= 2000  => Tier.silver,
    default  => Tier.bronze,
  }
}

action ScanToEarn {
  input {
    receipt: Credential<PurchaseReceipt>
  }

  require {
    // Narrowing, in words rather than in `!= null`: this block is read by
    // people for whom `null` is jargon. Without this line, reading through
    // `state.member` below is a type error rather than a crash at runtime.
    //
    // This block is for defects. If it fails, the app asked for something it
    // had no business asking for: the action aborts and nobody is shown a
    // message. Business rules go in `verify`, where failing is normal.
    state.member exists
  }

  verify {
    // The only way to obtain `Verified<ReceiptFromMerchant>`. The type names the
    // *policy*, not the credential: data checked against a strict policy and
    // data checked against a lax one must not share a type.
    const checked = receipt with ReceiptFromMerchant

    // Failing here is an ordinary outcome — a forged or expired receipt — and
    // the person is told plainly.
    checked.claims.purchased_at > context.time.now - duration(days: 30)
  }

  compute {
    // Pure, and so is every `function`. An effect here is a compile error, and
    // there is no effectful function it could hide behind.
    const satangPerBaht = 100
    const earned = checked.claims.amount / satangPerBaht
    const total  = state.lifetimePoints + earned     // traps on overflow
    const tier   = tierFor(total)
  }

  update {
    // A patch, not an expression: each line names a field and the value it
    // takes, and anything not named is unchanged. `:` and not `=`, because
    // nothing is assigned — this describes the next state, and the previous one
    // is still readable on the right of every line.
    //
    // It is also the table somebody reviewing this app wants: three lines, and
    // they are the whole of what a scan changes.
    lifetimePoints: total
    member.points:  state.member.points + earned
    member.tier:    tier
  }

  execute {
    // The only phase where an effect appears, and the effects here are one
    // batch: the host takes all of them or none, and the state above commits
    // only if it took them. This does not issue anything — it emits an
    // EffectRequest and stops.
    // `next` is the state `update` produced. Reading `state.member.points +
    // earned` here instead would be the same arithmetic written twice, in two
    // phases, and the day one of them is edited the execution record proves the
    // disagreement rather than catching it.
    credential.issue(LoyaltyMember {
      member_id: next.member.member_id,
      tier:      next.member.tier,
      points:    next.member.points,
    })
  }
}
