// Scan a purchase receipt, earn points, reissue the membership credential.
//
// The canonical example: every phase, both verifiability types, and the thing
// that makes VAL different from a scripting language — the compiler knowing,
// before it runs, that this app can issue exactly one credential type and read
// exactly one other.

app "th.co.codefin.loyalty"
version 1

capabilities {
  // Type references, not strings. The types are declared below; a string here
  // would be an unchecked second copy of a name.
  credential.read(PurchaseReceipt)
  credential.issue(LoyaltyMember)
}

enum Tier { bronze, silver, gold }

credential PurchaseReceipt {
  merchant:     string
  amount:       int        // satang. There is no float in the language, and
  purchased_at: datetime   // money did not want one.
}

credential LoyaltyMember {
  member_id: string
  tier:      Tier
  points:    int
}

state {
  member:          LoyaltyMember?
  lifetime_points: int = 0
}

// The subject is bound by name. `receipt.signature.valid`, never a bare
// `signature.valid` — an implicit receiver is unambiguous exactly until a
// second credential is in scope.
trust ReceiptFromMerchant(receipt: PurchaseReceipt) {
  // An anchor, not a pinned issuer: the chain answers who is under it. Pinning
  // would put this app's private allowlist somewhere the person cannot see.
  anchor { "th.co.codefin.merchants" }

  require {
    receipt.signature.valid
    receipt.status.active
    receipt.holder.bound
    receipt.claims.amount > 0
  }
}

function tierFor(points: int): Tier {
  return points >= 10000 ? Tier.gold
       : points >= 2000  ? Tier.silver
       : Tier.bronze
}

action ScanToEarn {
  input {
    receipt: Credential<PurchaseReceipt>
  }

  require {
    // Narrowing. Without this line, reading through `state.member` below is a
    // type error rather than a null dereference at runtime.
    //
    // This block is for defects: if it fails, this app asked for something it
    // had no business asking for, the action aborts, and nobody is shown a
    // message about it. Business rules go in `verify`, where failing is normal.
    state.member != null
  }

  verify {
    // The only way to obtain `Verified<ReceiptFromMerchant>`. The type names the
    // *policy*, not the credential: data checked against a strict policy and
    // data checked against a lax one must not share a type.
    const checked = receipt with ReceiptFromMerchant

    // Failing here is an ordinary outcome — a forged or expired receipt — and
    // the person is told plainly.
    checked.claims.purchased_at > context.time.now - duration(days: 30)
  }

  compute {
    // Pure, and so is every `function`. An effect here is a compile error, and
    // there is no effectful function it could hide behind.
    const earned = checked.claims.amount / 100      // one point per baht
    const total  = state.lifetime_points + earned   // traps on overflow
    const tier   = tierFor(total)
  }

  update {
    // Evaluates to the next state. No assignment anywhere in the language: a
    // record is derived by spreading, never mutated in place. Spread is typed —
    // the result is the same record type, so it cannot invent or drop a field.
    {
      ...state,
      lifetime_points: total,
      member: { ...state.member,
                points: state.member.points + earned,
                tier:   tier },
    }
  }

  execute {
    // The only phase where an effect appears. This does not issue anything: it
    // emits an EffectRequest and stops. The host asks whether the capability
    // was declared, whether the person consented, whether policy allows it —
    // and the answer may be no, in which case the state above is not committed.
    credential.issue(LoyaltyMember {
      member_id: state.member.member_id,
      tier:      tier,
      points:    state.member.points + earned,
    })
  }
}
