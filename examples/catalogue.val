// Every component the wallet ships, on one screen.
//
// The catalogue is small on purpose: a Micro App declares what a thing is, and
// the wallet decides what it looks like. Asking for something that is not here
// is reported rather than approximated — try adding `tabs { … }` and read what
// the compiler says.

app "id.vaulet.example.catalogue"
version 1

capabilities {
  credential.read(PurchaseReceipt)
}

credential PurchaseReceipt {
  merchant:     string
  amount:       int
  purchased_at: datetime
}

trust AnyReceipt(receipt: PurchaseReceipt) {
  anchor: "th.co.codefin.merchants"
  require {
    receipt.signature.valid
    receipt.status.active
    receipt.holder.bound
  }
}

state {
  presses: int default 0
}

// Two actions, so a primary and a secondary button each have somewhere to go.
// A button with no action is a button nobody can press.
action Press {
  compute {
    const next_count = state.presses + 1
  }

  update {
    presses: next_count
  }
}

action Answer {
  input {
    remind: bool
    shop:   string
    spend:  int
  }

  update {
    presses: spend
  }
}

action Reset {
  update {
    presses: 0
  }
}

screen Catalogue start: true {
  // What this screen sees of the wallet, resolved before anything is drawn.
  data {
    receipts: credentials of PurchaseReceipt verified with AnyReceipt
      order by purchased_at desc
      limit 5
  }

  // Pure, an action's rules, no effects. A total kept here rather than in
  // `state` is a total that cannot disagree with what is on the screen.
  compute {
    const spent = receipts.fold(0) { sum, r -> sum + r.claims.amount }
    const merchants = receipts.map { r -> r.claims.merchant }
  }

  column {
    // `carousel` — pages side by side, with dots. The page it is on is the
    // wallet's, like a scroll position.
    carousel {
      banner(text: phrase("bannerOne"), detail: phrase("bannerOneDetail"), icon: money, onTap: Press)
      banner(text: phrase("bannerTwo"), detail: phrase("bannerTwoDetail"), icon: shield)
    }

    // `grid` — across and down, at however many columns are asked for.
    section(text: phrase("categories"))
    grid(columns: 3) {
      card(text: phrase("catFood"))
      card(text: phrase("catTravel"))
      card(text: phrase("catBills"))
    }

    // `card` — a heading with values in it.
    card(text: phrase("summary", presses: state.presses, spent: spent))

    // `section` — a subhead, which is how this wallet groups what follows.
    section(text: "rows")

    // `tile` — a line with a leading icon, a supporting line under it, and
    // whatever sits at the end: a chevron, a badge, or nothing. `trailing` is
    // read where it is given; a chevron is the default only where there is an
    // action to go to.
    tile(text: phrase("plainRow"), detail: phrase("plainDetail"))
    tile(text: phrase("pressableRow"), icon: check, onTap: Press)
    tile(text: phrase("badgeRow"), detail: phrase("badgeCount"), trailing: badge, icon: money)

    // `list` — one row per element, with each element's slots resolved. An
    // empty list draws the wallet's own empty state, never yours.
    section(text: "fromTheWallet")
    list(receipts) { r ->
      tile(text: phrase("receiptRow", merchant: r.claims.merchant, at: r.claims.purchased_at),
           onTap: Receipt(merchant: r.claims.merchant, amount: r.claims.amount))
    }

    // Content that is neither a row nor a card: prose, a number worth looking
    // at, a label against a value, a mark on something.
    section("Content")
    text("A paragraph. Not a card and not a row — prose, which every About screen was faking with a card until this existed.")
    row {
      gap: 12
      align: center
      avatar("Somchai") { size: 44 }
      column {
        flex: 1
        stat("Points this year") { value: "1,250" }
      }
      badge("Verified")
    }
    keyValue("Member since") { value: "2024" }
    link("Read the terms") { to: "https://vaulet.id/terms" }

    // While something is coming, and when nothing is there.
    section("Waiting and empty")
    skeleton { lines: 2 }
    emptyState("Nothing here yet") {
      detail: "Scan a receipt and it will show up"
      icon: receipt
    }

    // More ways to answer than a line of text.
    section("Answers")
    checkbox("Send me reminders") { into: remind }
    select("Favourite shop") { of: merchants, into: shop }
    slider("How many points to spend") { min: 0, max: 100, into: spend }

    // Data, laid out as data.
    section("Data")
    dataTable(receipts) { columns: ["merchant", "amount"] }
    timeline {
      timelineItem("Scanned a receipt") { at: "16 Aug", detail: "Codefin Coffee" }
      timelineItem("Reached bronze") { at: "11 Aug" }
    }

    accordion("What is a Micro App?") {
      detail: "Tap to read"
      text("It runs inside somebody's wallet, reads credentials they already hold, and asks the wallet to act.")
    }

    // `button` — `emphasis: primary` is the one that docks to the bottom of the
    // screen. Anything else is an outlined button in the flow of the column.
    section(text: "buttons")
    button(text: "secondary", emphasis: secondary, onTap: Reset)
    button(text: phrase("working"), emphasis: secondary, state: busy, onTap: Press)
    button(text: phrase("notNow"), emphasis: secondary, state: disabled, onTap: Press)
    button(text: "primary", emphasis: primary, onTap: Answer)
  }
}

// A screen opened with a row. It is written once and works for every receipt,
// because what it needs arrives as parameters rather than being read out of a
// selection somebody had to remember to set.
screen Receipt(merchant: string, amount: int) {
  title: phrase("receiptTitle")

  column {
    card(text: phrase("receiptDetail", merchant: merchant, amount: amount))
  }
}
