// Programs that must not compile, and the error each one is owed.
//
// Not a valid file: every action below is here to be refused. It is a checklist
// for the type checker, and the messages are part of the language — a rule that
// produces only "type error" has not been taught to anybody.

app "id.vaulet.example.rejected"
version "1.0.0"

capabilities {
  credential.read(PurchaseReceipt)
}

enum Tier { bronze, silver, gold }

state {
  member: LoyaltyMember?
  points: int default 0
}

// 1. An effect in a pure phase.
action EffectInCompute {
  compute {
    // error: `credential.issue` is an effect and `compute` is pure.
    //        Effects may only appear in `execute`.
    const c = credential.issue(LoyaltyMember { … })
  }
}

// 2. An effect hidden behind a function.
function issueIt(m: LoyaltyMember) {
  // error: functions are pure. There is no effectful function in this language,
  //        which is why "what can this action do" is answerable by reading one
  //        block instead of a call graph. Write the effect in `execute`, even
  //        if that means writing it more than once.
  credential.issue(m)
}

// 3. An effect the app never declared.
action UndeclaredCapability {
  execute {
    // error: this app declares `credential.read` and not `payment.request`.
    //        Capabilities are in the manifest the person consented to, so
    //        adding one is a new version, not an edit.
    payment.request(amount: 100)
  }
}

// 4. Disclosure without the capability for it.
action SilentDisclosure {
  execute {
    // error: `present` requires the `disclosure.present` capability, which this
    //        app does not declare. Handing a claim to somebody else is an
    //        effect like any other, and a person consented to a list that did
    //        not include it.
    present { disclose receipt.claims.country }
  }
}

// The two declarations cases 5 and 6 are about. Without a signature there is
// nothing demanding `Verified<…>`, and without a second policy there is nothing
// to be verified against the wrong one — the programs below are unchanged.
credential PurchaseReceipt as "https://org.vaulet.id/example/credential/purchase-receipt" {
  merchant: string
  amount:   int
}

trust ReceiptFromMerchant(r: PurchaseReceipt) {
  anchor: "th.co.codefin.merchants"
  require {
    r.signature.valid
    r.status.active
    r.holder.bound
  }
}

trust SignatureOnly(r: PurchaseReceipt) {
  anchor: "th.co.codefin.merchants"
  require { r.signature.valid }
}

function trustedAmount(receipt: Verified<ReceiptFromMerchant>): int {
  return receipt.claims.amount
}

// 5. Using data that was never verified.
action UnverifiedData {
  input { receipt: Credential<PurchaseReceipt> }
  compute {
    // error: expected `Verified<ReceiptFromMerchant>`, found
    //        `Credential<PurchaseReceipt>`. Pass it through a `verify` block;
    //        there is no cast, because a cast is how the check gets forgotten.
    const earned = trustedAmount(receipt)
  }
}

// 6. Verified, but against the wrong policy.
action WrongPolicy {
  input { receipt: Credential<PurchaseReceipt> }
  verify {
    const checked = receipt with SignatureOnly
  }
  compute {
    // error: expected `Verified<ReceiptFromMerchant>`, found
    //        `Verified<SignatureOnly>`. Policies are nominal: a signature that
    //        is valid says nothing about whether the credential was revoked,
    //        or about who issued it. If one policy really does subsume the
    //        other, declare it — do not rely on both being called "verified".
    const earned = trustedAmount(checked)
  }
}

// 7. An optional that was never narrowed.
action MissingNarrow {
  update {
    // error: `state.member` may not exist. Say `state.member exists` in
    //        `require` before reading through it — narrowing is a phase, not a
    //        check scattered through the code.
    member.points: state.member.points + 1
  }
}

// 8. Assignment.
action Mutation {
  update {
    // error: `update` is a patch, not a sequence of assignments. Write
    //        `member.points: 10` — a colon, because the line describes the next
    //        state rather than changing this one, and `state.member.points` is
    //        still readable on the right of it.
    state.member.points = 10
  }
}

// 8b. A list index in a patch path.
action IndexInPath {
  update {
    // error: a patch path may not contain a list index. That is where this
    //        would need an optics story, and it does not have one: build the
    //        new list in `compute` and name it here in one line.
    stamps[3].used: true
  }
}

// 9. A switch that will not break when the enum grows.
action DefaultOverEnum {
  compute {
    // error: `switch` over an enum may not use `default`. Adding
    //        `Tier.platinum` must break every program that decides something
    //        per tier — that is the whole reason this is an enum, not a string.
    const discount = switch (state.member.tier) {
      Tier.gold => 10,
      default   => 0,
    }
  }
}

// 9b. A switch arm that can never be reached.
action DeadArm {
  compute {
    // error: `>= 10000` is unreachable — `>= 2000` above it matches everything
    //        it would. Arms are tried in order, which is fine; order-dependence
    //        nobody can see is not.
    const tier = switch (state.points) {
      >= 2000  => Tier.silver,
      >= 10000 => Tier.gold,
      default  => Tier.bronze,
    }
  }
}

// 9c. A record literal in a patch.
action LiteralInPatch {
  update {
    // error: `update` takes paths, not record literals. `member.tier: tier`
    //        says this already, and two ways to write one thing is the cost
    //        this language spends its whole budget avoiding. If it really is a
    //        whole new record, build it in `compute` and name it here.
    member: { ...state.member, tier: Tier.gold }
  }
}

// 9d. Two disclosures in one action.
action DiscloseTwice {
  execute {
    // error: an action performs at most one disclosure. Effects here are one
    //        batch that the host takes or refuses whole — and a disclosure
    //        cannot be taken back, so the second one cannot be conditional on
    //        a batch the first has already completed. Two disclosures want two
    //        consents, which is two actions.
    present { disclose id.claims.country }
    present { prove id.claims.birthdate <= context.time.now }
  }
}

// 9e. Unlabelled arguments.
action PositionalArgs {
  execute {
    // error: arguments are named once there are two of them. Write
    //        `payment.request(to: merchant, amount: 12000)`. This line is read
    //        far more often than it was written, frequently by somebody
    //        deciding whether to approve what it does.
    payment.request(merchant, 12000)
  }
}

// 9f. A claim path that is not a leaf.
action HalfAnAddress {
  compute {
    // error: no claim is named `address`. The register spells the parts —
    //        `address.postal_code`, `address.region` — and a credential holds
    //        them apart, so this would be a record with no issuer behind it.
    //        Name the leaf.
    const where = checked.claims.address
  }
}

// 10. Nondeterminism.
action Nondeterministic {
  compute {
    // error: no such function. Time and randomness come from the runtime
    //        context, which is recorded — `context.time.now`,
    //        `context.random.uuid`. An action that cannot be replayed cannot be
    //        proved, and proving it is the entire point.
    const now = Date.now()
  }
}

// 11. Recursion.
function total(items: List<int>, i: int): int {
  // error: the call graph must be acyclic. This language is total: every
  //        program halts, and the compiler knows it rather than a fuel meter
  //        finding out. Use `fold`.
  return i >= items.count ? 0 : items[i] + total(items, i + 1)
}

// 12. A float.
action Floats {
  compute {
    // error: no floating-point type in this language. NaN bit patterns are the
    //        main source of nondeterminism under Wasm, and money wants integers
    //        or fixed point regardless. Use satang, not baht.
    const price = 12.50
  }
}

// 13. Writing a `const` again.
action WriteAConst {
  compute {
    const fixed = 1
    // error: `fixed` is a `const`, so it is what it was defined as. A definition
    //        can be read from anywhere in the block; a variable has to be read
    //        downwards, so the language makes you say which one you meant.
    fixed = 2
  }
}

// 14. Writing a name where nothing is worked out.
action WriteInRequire {
  require {
    let x = 1
    // error: `require` holds conditions. The two places a value is worked out
    //        are `compute` and a function, and a name is written again in those.
    x = 2
  }
}

// 15. A range longer than a screen can be made of.
screen TooManyRows {
  column {
    // error: every list in this language is bounded. A range is written, so its
    //        bound is written too — ten thousand, refused here rather than
    //        found by a phone.
    for (i in 1...999999) {
      text(i)
    }
  }
}

// 16. A combinator with no function.
function nothingToApply(xs: List<int>): List<int> {
  // error: `map` is given a function — written where it is used, or the name of
  //        one this package declares. Given neither it used to return the list
  //        unchanged, which compiled, ran, and did nothing.
  return xs.map(notAFunction)
}

// 17. A loop that does not say what it reads over.
screen WrongLoopWord {
  column {
    // error: a loop reads `for (row in rows)`.
    for (i of 1...3) {
      text(i)
    }
  }
}

// 18. A keyword as a name.
action KeywordName {
  compute {
    // error: a keyword is never a name, so reading a declaration never depends
    //        on knowing what else the package declared.
    const screen = 1
  }
}

// 19. A name in a tree that is neither bound nor a word.
@main
screen Typo {
  column {
    // error: a bare name on a screen is bound — state, data, a computed value,
    //        a parameter, a row — or it is a word the host's registry has, or
    //        it names an action a press moves to. Anything else was drawn as
    //        itself, so a misspelt binding reached the screen as the word
    //        somebody typed.
    text(pointss)
  }
}

// 20. An effect in one branch of `execute`.
//
// Not a program that fails to compile — a program whose report has to name the
// branch nobody took. The report is checked in `crates/valang/tests/report.rs`,
// and it is here because the failure it prevents belongs on this list: a
// capability that runs and does not appear on the consent sheet.

// 21. A screen that acts.
screen ActingScreen {
  compute {
    // error: a screen derives and does not act. Its `compute` follows an
    //        action's rules — and a credential issued while a screen is being
    //        drawn is one nobody pressed anything to get.
    const c = credential.issue(LoyaltyMember { member_id: "x" })
  }

  column {
    section("x")
  }
}

// 22. A state field that starts somewhere else.
//
// error: a default is read before anything has run. There is no scope to read a
//        name from and no previous version to ask, so a name here resolves to
//        nothing quietly — a field starting as null on a phone rather than as
//        the number it says.

// 23. A number in a base this language does not have.
action Hex {
  compute {
    // error: numbers are decimal. `0xff` was two tokens — the number `0` and a
    //        name nothing read — so a base that does not exist came out as
    //        zero and said nothing.
    const mask = 0xff
  }

  update {
    presses: 0
  }
}

// 24. A list computed over with no bound.
action Unbounded {
  verify {
    // error: `receipts` is computed over and says no `limit`. A bound is what
    //        makes the work knowable before it runs — and what makes a proof
    //        over it cost the bound rather than the data, which is also why it
    //        does not leak how much the person holds.
    const receipts = credentials of PurchaseReceipt verified with ReceiptFromMerchant
  }

  compute {
    const total = receipts.fold(0) { sum, r -> sum + r.claims.amount }
  }

  update {
    presses: total
  }
}
