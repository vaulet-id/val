// An application that does not open for everybody.
//
// The `admits` block is the whole point of this example: without a current
// Acme badge, this application does not draw its first screen, does not run an
// action, and is not a thing the person can look at. Everything else here is
// ordinary.
//
// **The host answers the door, and this program never asks.** There is no way
// to write "does the person hold one?" in VAL, and that is deliberate: a
// program that could ask would be holding the credential in order to find out
// it was absent, which is the read a gate exists instead of. What an admitted
// application learns is that it opened.

app "th.co.acme.staff"
version 5

capabilities {
  // A check and not a read. This application is told the door opened; it is
  // never told the badge number, the department or the date — and a sheet
  // saying "reads your employee badge" about it would be false.
  credential.check(EmployeeBadge)
}

credential EmployeeBadge as "https://org.vaulet.id/acme/credential/staff-badge" {
  employee_id: string
  department:  string
  valid_until: date
}

trust EmployedByAcme(badge: EmployeeBadge) {
  // The company's own anchor, and so a badge the company revoked stops opening
  // this door without anybody shipping a new version.
  anchor: "th.co.acme.hr"

  require {
    badge.signature.valid
    badge.status.active
    badge.holder.bound
  }
}

// One line, and it is a condition rather than a preference: a person without a
// badge that passes `EmployedByAcme` sees `notStaff` and no screen.
//
// The policy is not optional — a gate that admitted anything shaped like a
// badge admits a badge somebody made — and neither is the sentence, because a
// door that closes without saying why leaves the person with a fault report
// instead of an instruction.
admits {
  EmployeeBadge with EmployedByAcme else "notStaff"
}

state {
  shift: string default ""
}

action ClaimShift {
  input {
    which: string
  }

  require {
    which != ""
  }

  update {
    shift: which
  }
}

@main
screen Rota {
  title: phrase("rotaTitle")

  column {
    // **The card, drawn by the host.** The application names which one and
    // never draws it: the face of a card — the issuer's colour, the issuer's
    // current word about it, what a withdrawal looks like — belongs to the
    // wallet that issued the design, so one change there changes every
    // application at once. Nothing off the card reaches this program: it holds
    // `credential.check`, and naming a credential is not reading one.
    credentialCard(of: EmployeeBadge)

    // **And the same card, drawn by the application out of the design
    // capability alone** — no card node, no help from the host. Every prop here
    // is one `hosts/core.json` has declared on every drawing node since the
    // catalogue was written: a gradient, an aspect ratio, a radius, a padding,
    // a colour, a size, a weight. This is the answer to "is the vocabulary
    // enough to design with": a publisher's own product can look like their
    // own product.
    column(
      gradient: ["#0E7C66", "#0A5348"],
      borderRadius: 20,
      aspectRatio: 1586,
      padding: loose,
      justify: between
    ) {
      row(justify: between, align: start) {
        column(gap: none) {
          text(phrase("companyName"), color: "#FFFFFF", fontWeight: bold, fontSize: 17)
          text(phrase("roleValue"), color: "#BFE3D8", fontSize: 12)
        }
        avatar(of: phrase("companyInitial"), size: 40)
      }
      row(justify: between, align: end) {
        column(gap: none) {
          text(phrase("shiftLabel"), color: "#BFE3D8", fontSize: 11, letterSpacing: 80)
          text(state.shift, color: "#FFFFFF", fontSize: 22, fontWeight: bold)
        }
        badge(text: phrase("admitted"))
      }
    }
    card(text: phrase("onShift", shift: state.shift))
    field(text: phrase("pickShift"), icon: document, into: which)
    button(text: phrase("claim"), emphasis: primary, onTap: ClaimShift)
  }
}
