// A form, and where what it holds lives.
//
// Nothing a person types is application state. The wallet holds it while they
// are typing, hands it over when they submit, and the action is given it as
// `input` — so `state` stays the thing that is hashed, signed and replayed.

app "id.vaulet.example.note"
version "1.0.0"

capabilities {
}

state {
  note:      string default ""
  reminders: bool default false
  tag:       string default ""
}

action Save {
  input {
    body:   string
    remind: bool
    tag:    string
  }

  require {
    body != ""
  }

  update {
    note:      body
    reminders: remind
    tag:       tag
  }
}

@main

screen Note {
  title: phrase("noteTitle")

  column {
    card(text: phrase("current", note: state.note, tag: state.tag))

    section(text: phrase("write"))
    field(text: phrase("body"), icon: document, into: body)
    toggle(text: phrase("remind"), into: remind)

    // A screen that returns a value writes into the same name a field would.
    tile(text: phrase("pickTag"), onTap: PickTag)

    button(text: phrase("save"), emphasis: primary, onTap: Save)
    button(text: phrase("about"), emphasis: secondary, onTap: About)
  }
}

// A second screen, reached by a press. `onTap: About` is
// `navigation.navigate(to: About)` written short, and coming back is the host's
// — an application never declares a way back.
// A picker. It returns into `tag`, which is what the form on the screen that
// opened it is collecting — no new mechanism, the same names its fields use.
screen PickTag present: sheet {
  title: phrase("pickTagTitle")

  column {
    tile(text: phrase("tagWork"), onTap: navigation.back(with: { tag: "work" }))
    tile(text: phrase("tagHome"), onTap: navigation.back(with: { tag: "home" }))
  }
}

screen About present: sheet {
  title: phrase("aboutTitle")

  column {
    card(text: phrase("aboutBody"))
  }
}
